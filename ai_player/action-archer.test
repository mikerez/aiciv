# Archer simulations.

scenario archer_holds_hill
unit archer 3 3
tile 3 3 hills local=0.50
tile 5 3 grass enemy=1 local=-0.15
features worker=0.50 nearby=0.00 fresh=0.00 city_score=0.00 city_dist=0.50
expect command wait
expect effect defended_hill
end

scenario archer_advances_to_strategy_focus
unit archer 3 3
tile 3 3 grass local=0.25
tile 5 3 hills local=0.50
target 5 3
features strategy_dx=0.50 strategy_dy=0.00 worker_focus=0.90
expect command goto
expect effect moved
end

scenario archer_advances_west_to_strategy_focus
unit archer 3 3
tile 3 3 grass local=0.25
tile 1 3 hills local=0.50
target 1 3
features strategy_dx=-0.50 strategy_dy=0.00 worker_focus=0.90
expect command goto
expect effect moved
end
