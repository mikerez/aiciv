# Horseman simulations.

scenario horseman_attacks_adjacent_enemy
unit horseman 3 3
tile 3 3 grass local=0.25
tile 4 3 grass enemy=1 local=-0.15
target 4 3
features worker=0.70 nearby=0.00 fresh=0.00 city_score=0.00 city_dist=0.50
expect command attack
expect effect enemy_removed
end

scenario horseman_advances_to_strategy_focus
unit horseman 3 3
tile 3 3 grass local=0.25
tile 5 4 grass local=0.25
target 5 4
features strategy_dx=0.50 strategy_dy=0.25 worker_focus=0.95
expect command goto
expect effect moved
end

scenario horseman_advances_west_to_strategy_focus
unit horseman 3 3
tile 3 3 grass local=0.25
tile 1 2 grass local=0.25
target 1 2
features strategy_dx=-0.50 strategy_dy=-0.25 worker_focus=0.95
expect command goto
expect effect moved
end
