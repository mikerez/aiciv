# Small Action-engine simulations for settler decisions.
# Format:
# scenario NAME
# unit UNIT_TYPE i j
# tile i j TERRAIN [resource=NAME] [food=YIELD] [water=1] [hidden=1] [enemy=1] [city=1] [local=VALUE]
# features worker=N nearby=N fresh=N city_score=N city_dist=N age=N
# target i j
# expect command ACTION_LABEL
# expect effect EFFECT_LABEL
# expect final EFFECT_LABEL
# expect turns N
# end

scenario settler_builds_city_on_good_fresh_grass
unit settlers 3 3
tile 3 3 grass resource=rice water=1 local=0.47
tile 4 3 grass water=1
features nearby=0.20 fresh=1.00 city_score=0.82 city_dist=0.80
expect command build_city
expect effect city
end

scenario settler_moves_from_weak_desert
unit settlers 3 3
tile 3 3 desert local=0.13
tile 4 3 grass resource=wheat water=1 local=0.80
features nearby=0.45 fresh=0.00 city_score=0.18 city_dist=0.50
target 4 3
expect command goto
expect effect moved
end

scenario settler_moves_from_jungle_without_resource_or_water
unit settlers 3 3
tile 3 3 jungle local=0.75
tile 4 3 grass resource=wheat water=1 local=0.80
features nearby=0.00 fresh=0.00 city_score=0.30 city_dist=0.86
target 4 3
expect command goto
expect effect moved
end

scenario old_settler_still_moves_from_unsupported_jungle
