# Warrior simulations.

scenario warrior_attacks_adjacent_enemy
unit warrior 3 3
tile 3 3 grass local=0.25
tile 4 3 grass enemy=1 local=-0.15
target 4 3
features worker=0.70 nearby=0.00 fresh=0.00 city_score=0.00 city_dist=0.50
expect command attack
expect effect enemy_removed
end

scenario warrior_defends_hill
unit warrior 3 3
tile 3 3 hills local=0.50
tile 5 3 grass enemy=1 local=-0.15
features worker=0.50 nearby=0.00 fresh=0.00 city_score=0.00 city_dist=0.50
expect command wait
expect effect defended_hill
end
