# Warrior simulations.

scenario warrior_attacks_adjacent_enemy
unit warrior 3 3
tile 3 3 grass local=0.25
tile 4 3 grass enemy=1 local=-0.15
target 4 3
features worker=0.70 nearby=0.00 fresh=0.00 city_score=0.00 city_dist=0.50
expect command attack
expect effect enemy_removed
end

scenario warrior_defends_hill
unit warrior 3 3
tile 3 3 hills local=0.50
tile 5 3 grass enemy=1 local=-0.15
features worker=0.50 nearby=0.00 fresh=0.00 city_score=0.00 city_dist=0.50
expect command wait
expect effect defended_hill
end

scenario warrior_advances_to_strategy_focus
unit warrior 3 3
tile 3 3 grass local=0.25
tile 5 3 grass local=0.25
target 5 3
features strategy_dx=0.50 strategy_dy=0.00 worker_focus=0.95
expect command goto
expect effect moved
end

scenario warrior_advances_west_to_strategy_focus
unit warrior 3 3
tile 3 3 grass local=0.25
tile 1 3 grass local=0.25
target 1 3
features strategy_dx=-0.50 strategy_dy=0.00 worker_focus=0.95
expect command goto
expect effect moved
end

scenario warrior_advances_north_to_strategy_focus
unit warrior 3 3
tile 3 3 grass local=0.25
tile 3 1 grass local=0.25
target 3 1
features strategy_dx=0.00 strategy_dy=-0.50 worker_focus=0.95
expect command goto
expect effect moved
end

scenario warrior_advances_southwest_to_strategy_focus
unit warrior 3 3
tile 3 3 grass local=0.25
tile 1 1 grass local=0.25
target 1 1
features strategy_dx=-0.50 strategy_dy=-0.50 worker_focus=0.95
expect command goto
expect effect moved
end
