scenario worker_alone_rejects_smallest_city_strategy_order
unit worker 3 3
tile 3 3 grass improvement=cottage local=0.25
features worker=0.80 nearby=0.00 fresh=0.00 city_score=0.42 city_dist=0.16 strategy_dx=0.75 strategy_dy=-0.25 worker_focus=0.88 nearby_workers=0.00
