# Worker simulations cover direct terrain jobs and resource improvements.

scenario worker_irrigates_fresh_grass
unit worker 3 3
tile 3 3 grass water=1 local=0.47
tile 4 3 grasswater water=1
features worker=0.60 nearby=0.05 fresh=1.00 city_score=0.35 city_dist=0.50
expect command irrigate
expect effect irrigation
end

