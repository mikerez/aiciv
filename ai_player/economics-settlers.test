# Economics expansion-wave tests. Candidate count fields mirror ai.js; one
# active Settler is encoded as settlers=0.125.

scenario safe_food_city_produces_requested_settler
city population=0.30 food=0.88 production=0.42 money=0.42 frontier=0.70 garrison=0.35
state cities=0.13 free_cities=0.13 settlers=0.00 workers=0.25 military=0.18 enemy_military=0.05 account=0.55 delta=0.18 upkeep=0.15
tech opened=1.00
demand settlers=0.62 worker=0.12 explorer=0.06 military=0.20
candidates none warrior worker explorer settlers slinger archer spearman
expect production settlers
end

