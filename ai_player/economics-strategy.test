# Economics strategy tests.
# Format:
# scenario NAME
# city record=N population=N food=N production=N money=N frontier=N seaside=N garrison=N free=1 legal=1
# state cities=N free_cities=N workers=N military=N enemy_military=N idle=N
# tech opened=N
# demand settlers=N worker=N explorer=N military=N
# expect production UNIT_TYPE
# end

