# Economics Worker usefulness tests.
# Technology flags and matching plot counts are separate inputs. A Worker is
# correct only when both members of at least one pair are present.
#
# tech: wheel bronze irrigation animals mining masonry pottery construction
# plots: road forest irrigation animals mine masonry pottery construction

scenario wheel_and_road_plot_produce_worker
city record=0 population=0.22 food=0.48 production=0.68 money=0.30 frontier=0.30 garrison=0.45 free=1 legal=1
state cities=0.06 free_cities=0.13 workers=0.00 military=0.25 account=0.40 delta=0.15 upkeep=0.10
tech opened=0.10 wheel=1
plots road=0.50
demand settlers=0.05 worker=0.85 explorer=0.03 military=0.07
expect production worker
end

