# Strategy landscape/resource contrast tests.
# context visible=1 means zero terrain/resource fields are observed negatives,
# not unknown data. Inputs match ai.js strategyCityContextStats() slots 24..40.

scenario high_hills_without_resources_choose_mining
terrain hills=0.72 rocks=0.08 grass=0.20 water=0.00
resources animals=0.00 stone=0.00 crops=0.00
context visible=1.00 flat=0.00 fresh=0.00 forest=0.02 resources=0.00 minerals=0.10 city=1 settler=0
tech opened=0.00
expect technology Mining
end

